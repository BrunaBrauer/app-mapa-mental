# Produção: dados e autenticação compartilhados entre dispositivos.
NEXT_PUBLIC_STORAGE_MODE=cloud
NEXT_PUBLIC_SUPABASE_URL=https://pzhsmwhoefxoedoamdao.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ative somente depois de configurar o provedor correspondente no Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_GITHUB_AUTH=false

# Para testar sem Supabase, use NEXT_PUBLIC_STORAGE_MODE=local.

# Google Drive (crie um OAuth Client ID do tipo Web e habilite Google Picker API + Drive API)
# Autorize https://www.nodumapp.site e http://localhost:5173 como origens JavaScript.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Chave de servidor do Google AI Studio. Configure somente no ambiente de servidor/Vercel.
GEMINI_API_KEY=
